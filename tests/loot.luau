local Loot = require("../src/ReplicatedStorage/Modules/LootMath")
local function equal(a,b) assert(math.abs(a-b)<0.00000001, tostring(a).." ~= "..tostring(b)) end
local c,s,p = Loot.Calculate(0,100,1,true,1000);equal(c,0);equal(s,0);equal(p,0)
c,s,p=Loot.Calculate(10,100,1,true,1000);equal(c,150);equal(s,.1);equal(p,.02)
c,s,p=Loot.Calculate(9,100,4,true,1000);equal(c,90);equal(p,0)
c,s,p=Loot.Calculate(100,100,1,true,1000);equal(c,1500);equal(s,1);equal(p,.08)
c,s,p=Loot.Calculate(100,100,2,true,1000);equal(c,1250)
c,s,p=Loot.Calculate(100,100,3,true,1000);equal(c,1100)
c,s,p=Loot.Calculate(100,100,4,true,1000);equal(c,1000)
c,s,p=Loot.Calculate(100,100,1,false,1000);equal(c,750);equal(p,.08)
c,s,p=Loot.Calculate(200,100,4,true,1000);equal(c,1000);equal(s,1)
c,s,p=Loot.Calculate(-5,100,1,true,1000);equal(c,0);equal(s,0)
